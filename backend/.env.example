# =============================================================================
# MedSimulator HMS — Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Frontend URLs (CORS whitelist) ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3001,http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Local MySQL (default for development)
DATABASE_PROVIDER=mysql
DATABASE_URL=mysql://root:yourpassword@localhost:3306/invinceible_core_hms_v2

# Neon PostgreSQL (set DATABASE_PROVIDER=postgresql to activate)
# Get both URLs from the Neon dashboard → Connection Details.
# DATABASE_URL      = pooled  URL (add ?pgbouncer=true&sslmode=require)
# DATABASE_URL_DIRECT = direct URL (add ?sslmode=require, no pgbouncer)
#
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:pass@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PASSWORD_MIN_LENGTH=12
AUTH_FAILED_LOGIN_DELAY_MAX_MS=2500
STEP_UP_TTL_SECONDS=300
STEP_UP_ENFORCEMENT_ENABLED=false

# ── Cache / rate limit ────────────────────────────────────────────────────────
# Leave REDIS_URL empty to use the built-in in-memory LRU cache
REDIS_URL=
CACHE_PREFIX=inv_hms
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_DASHBOARD_TTL_SECONDS=30
CACHE_REFERENCE_TTL_SECONDS=300
CACHE_IN_MEMORY_MAX_ITEMS=10000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_MAX=60
DASHBOARD_RATE_LIMIT_MAX=120
PDF_RATE_LIMIT_MAX=20
MPESA_RATE_LIMIT_MAX=5
PUBLIC_VERIFY_RATE_LIMIT_MAX=30
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT=4mb
PDF_IMAGE_MAX_BYTES=512000

# ── AI assistant ──────────────────────────────────────────────────────────────
# Keep this ONLY on the backend — never expose it in the frontend or mobile app
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# ── M-PESA / Daraja ───────────────────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-backend.onrender.com/billing/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PROMPT_LOCK_SECONDS=90
MPESA_MAX_CONCURRENT_PROMPTS=20
MPESA_REQUEST_TIMEOUT_MS=15000
MPESA_STATUS_CACHE_SECONDS=10

# ── Queue / worker ────────────────────────────────────────────────────────────
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_PREFIX=inv_hms
WORKER_MODE=false

# ── KRA eTIMS ─────────────────────────────────────────────────────────────────
ETIMS_ENABLED=false
ETIMS_MODE=mock
ETIMS_BASE_URL=
ETIMS_TIN=
ETIMS_BHF_ID=00
ETIMS_CMC_KEY=
ETIMS_DEVICE_SERIAL=
ETIMS_TIMEOUT_MS=15000
ETIMS_MAX_ATTEMPTS=8
ETIMS_DEFAULT_TAX_CODE=A
ETIMS_VAT_RATE=16
ETIMS_RECEIPT_VERIFY_URL=

# ── DHA ───────────────────────────────────────────────────────────────────────
DHA_ENABLED=false
DHA_MODE=mock
DHA_BASE_URL=
DHA_TOKEN_URL=
DHA_CLIENT_ID=
DHA_CLIENT_SECRET=
DHA_API_VERSION=v1
DHA_FACILITY_CODE=
DHA_TIMEOUT_MS=15000
DHA_MAX_ATTEMPTS=8

# ── Integration outbound worker ───────────────────────────────────────────────
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_POLL_MS=5000
INTEGRATION_QUEUE_BATCH_SIZE=10
INTEGRATION_RETRY_BASE_DELAY_MS=30000
INTEGRATION_RETRY_MAX_DELAY_MS=3600000
INTEGRATION_STUCK_REQUEST_MS=600000

# ── Password reset ────────────────────────────────────────────────────────────
PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password
RETURN_DEV_RESET_TOKEN=false

# ── Render-specific (production only) ────────────────────────────────────────
# TRUST_PROXY=true
# FRONTEND_URL=https://your-frontend.vercel.app
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
# PUBLIC_API_BASE_URL=https://hms-backend.onrender.com
# MPESA_CALLBACK_URL=https://hms-backend.onrender.com/billing/payments/mpesa/callback
# PASSWORD_RESET_BASE_URL=https://your-frontend.vercel.app/reset-password
