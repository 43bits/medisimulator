# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment variables (never commit secrets) ──────────────────────────────
.env
.env.*
!.env.example
!.env.example.*
# Keep .env.local.example if it exists, but never the real one
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma generated client (regenerated on install) ─────────────────────────
# Keep migrations and schema but not the generated JS client
backend/node_modules/
frontend/node_modules/
mobile/node_modules/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Expo / React Native ───────────────────────────────────────────────────────
mobile/.expo/
mobile/android/
mobile/ios/
mobile/dist/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tgz
.cache/
tmp/
temp/
