{
  "expo": {
    "name": "MedSimulator HMS",
    "slug": "hms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hms",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f5fbff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hms.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563a8"
      },
      "package": "com.hms.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "$EXPO_PUBLIC_API_URL"
    }
  }
}
