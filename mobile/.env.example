# =============================================================================
# MedSimulator HMS — Mobile (Expo) environment variables
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_* variables are bundled into the app at build time and are
# visible to client-side code. Do NOT put secrets here.
# =============================================================================

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development (Android emulator — use 10.0.2.2 instead of localhost):
EXPO_PUBLIC_API_URL=http://localhost:3000

# Local development on a physical device — use your machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Production (Render):
# EXPO_PUBLIC_API_URL=https://hms-backend.onrender.com
